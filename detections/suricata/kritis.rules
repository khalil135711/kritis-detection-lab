# Modbus/TCP: function code is the 8th byte (offset 7) of the payload.
# Lab rules - tune for real use (allowed engineering workstation, etc.).

alert tcp any any -> any 502 (msg:"KRITIS Modbus read burst (possible scanning)"; flow:to_server,established; content:"|03|"; offset:7; depth:1; threshold:type threshold, track by_src, count 10, seconds 10; classtype:attempted-recon; sid:9000001; rev:1; metadata:mitre_attack T0846;)

alert tcp any any -> any 502 (msg:"KRITIS Modbus write single register"; flow:to_server,established; content:"|06|"; offset:7; depth:1; classtype:attempted-admin; sid:9000002; rev:1; metadata:mitre_attack T0836;)

alert tcp any any -> any 502 (msg:"KRITIS Modbus write flood"; flow:to_server,established; content:"|06|"; offset:7; depth:1; threshold:type threshold, track by_src, count 20, seconds 10; classtype:attempted-dos; sid:9000003; rev:1; metadata:mitre_attack T0855;)
